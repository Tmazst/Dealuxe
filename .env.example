# uMshova Deluxe — environment variable reference
# Copy this file to `.env` (which is gitignored) and fill in your values.
# DO NOT commit secrets to the repository.

# --- Game / test bots ---
# When true, the reserved tournament_bot_1..3 accounts auto-play their turns
# so admins can test tournaments with 1 manual player + 3 bots.
TOURNAMENT_TEST_BOTS_ENABLED=true

# --- Version 3 pilot economy ---
# Enable these together for the no-cash pilot. Startup rejects paid entry or
# cash prizes when PILOT_MODE is true. With PILOT_MODE=false, Version 2
# tournament behavior remains available for regression and rollback.
PILOT_MODE=false
PILOT_CREDITS_ENABLED=false
PAID_TOURNAMENT_ENTRY_ENABLED=false
CASH_PRIZES_ENABLED=false
CUP_ENABLED=false
CUP_QUALIFICATION_ENABLED=false
CUP_CASH_PAYOUTS_ENABLED=false
# Live-event safety gate. Keep true for rehearsals and Cup day so a full
# qualification roster cannot launch until all 64 players are checked in.
CUP_REQUIRE_CHECK_IN_TO_START=true
CUP_EVENT_KEY=umshova-cup-pilot
CUP_SEASON=2026

# Hybrid MVP foundation (all disabled by default)
HYBRID_ENABLED=false
HYBRID_PROFILE_ENABLED=false
HYBRID_MATCHING_ENABLED=false
HYBRID_MATCHING_SHADOW_ENABLED=false
HYBRID_CHAT_ENABLED=false
HYBRID_BRACKET_DISCOVERY_ENABLED=false
HYBRID_PAYMENTS_ENABLED=false
HYBRID_RELATIONSHIP_ENABLED=false

# --- Future openWA customer-operations boundary ---
# V3-0908 provides names and contracts only. Startup intentionally rejects any
# true value until a separate implementation, legal/privacy review and rollout
# approval are complete. Do not add credentials yet.
OPENWA_ENABLED=false
OPENWA_SUPPORT_ENABLED=false
OPENWA_ALERTS_ENABLED=false
OPENWA_FEEDBACK_ENABLED=false
OPENWA_MESSAGING_ENABLED=false

# --- Version 3 paid plan passes ---
# Non-renewing seven-day defaults. Persistent administrator switches may
# override the master, Hybrid and Hybrid+ booleans; environment values remain
# startup defaults. Premium remains locked until its delivery adapter is live.
PRICING_ENABLED=false
PRICING_HYBRID_ENABLED=false
PRICING_HYBRID_PLUS_ENABLED=false
# Locked until the live openWA alert adapter is separately approved.
PRICING_PREMIUM_ENABLED=false
PRICING_HYBRID_PRICE=20
PRICING_HYBRID_PLUS_PRICE=40
PRICING_PREMIUM_PRICE=60
PRICING_HYBRID_DURATION_DAYS=7
PRICING_HYBRID_PLUS_DURATION_DAYS=7
PRICING_PREMIUM_DURATION_DAYS=7

# --- Flask environment ---
# "development" uses the threading Socket.IO async mode and permits an
# in-memory game-state fallback. Set an explicit non-local value in production
# to use gevent and require Redis plus the production security settings.
ENV=development

# High-entropy Flask session signing secret. Required outside local development.
# Generate a unique value per deployment; never commit the populated value.
FLASK_SECRET_KEY=

# Exact browser origins allowed to connect to Socket.IO, comma-separated.
# Wildcards are rejected. Use the public HTTPS origin in production.
SOCKETIO_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# --- Browser request trust boundary ---
# off     = skip provenance checks and security observations
# monitor = log requests that would be rejected, but allow them (pilot default)
# enforce = reject suspicious state-changing browser requests with HTTP 403
#Parent Mode for request security?
REQUEST_SECURITY_MODE=monitor

# Exact trusted browser origins, comma-separated. Never use a wildcard. Keep
# development ports synchronized with the address used to open the app.
REQUEST_SECURITY_TRUSTED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Independent pilot switches. Turning a check off can help isolate unrelated
# upgrade testing without disabling the remaining request-security signals.
REQUEST_SECURITY_CHECK_FETCH_METADATA=true
REQUEST_SECURITY_CHECK_ORIGIN=true
REQUEST_SECURITY_DETECT_CLI_CLIENTS=true

# Keep false unless every sibling subdomain is under the same trust boundary.
REQUEST_SECURITY_ALLOW_SAME_SITE=false

# Advanced escape hatch: exact Flask endpoint names only, comma-separated.
# Prefer the code-level machine-client marker for reviewed APIs/webhooks.
REQUEST_SECURITY_ADDITIONAL_MACHINE_ENDPOINTS=

# --- Session-cookie, rotation and CSRF security ---
# Cookie modes:
# off     = Flask baseline (HttpOnly remains on; Secure/SameSite are not added)
# pilot   = HttpOnly + SameSite, with Secure configurable for local HTTP testing
# enforce = HttpOnly + SameSite + mandatory Secure HTTPS-only cookie
SESSION_COOKIE_SECURITY_MODE=pilot
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Rotation and CSRF modes use the same staged rollout:
# off = disabled, monitor = observe without blocking/changing, enforce = active
SESSION_ROTATION_MODE=monitor
CSRF_SECURITY_MODE=monitor
CSRF_TOKEN_TIME_LIMIT_SECONDS=3600

# Advanced exact Flask endpoint exemptions. No wildcards are accepted. Normal
# browser APIs must send a token; only independently authenticated non-browser
# integrations such as a verified webhook should be exempted in code.
CSRF_ADDITIONAL_EXEMPT_ENDPOINTS=

# --- Sensitive-route and Socket.IO rate limiting ---
# off = disabled, monitor = count/log would-block decisions, enforce = HTTP 429
# and generic Socket.IO rejection. Pilot with monitor first, then tune thresholds.
RATE_LIMIT_MODE=monitor
# Local development uses bounded process memory. Multi-worker deployments must
# use Redis so every worker shares the same sliding windows.
RATE_LIMIT_STORAGE=memory

# Login checks independent IP and supplied-account buckets.
RATE_LIMIT_LOGIN_IP_ATTEMPTS=20
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_ACCOUNT_ATTEMPTS=8
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=300
RATE_LIMIT_PAYMENT_ATTEMPTS=30
RATE_LIMIT_PAYMENT_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_ATTEMPTS=240
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_ATTEMPTS=12
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=300
RATE_LIMIT_CSP_REPORT_ATTEMPTS=120
RATE_LIMIT_CSP_REPORT_WINDOW_SECONDS=60
RATE_LIMIT_SOCKET_CONNECT_ATTEMPTS=120
RATE_LIMIT_SOCKET_CONNECT_WINDOW_SECONDS=60
RATE_LIMIT_SOCKET_EVENT_ATTEMPTS=240
RATE_LIMIT_SOCKET_EVENT_WINDOW_SECONDS=60

# --- Browser security headers and Content Security Policy (CSP) ---
# Header modes: off = no application-added browser headers; pilot = baseline
# headers without HSTS; enforce = baseline headers plus HSTS on HTTPS responses.
BROWSER_SECURITY_HEADERS_MODE=pilot

# Independent header switches for temporarily isolating upgrade problems.
BROWSER_X_FRAME_OPTIONS_ENABLED=true
BROWSER_X_CONTENT_TYPE_OPTIONS_ENABLED=true
BROWSER_REFERRER_POLICY_ENABLED=true
BROWSER_PERMISSIONS_POLICY_ENABLED=true
BROWSER_HSTS_ENABLED=true
BROWSER_HSTS_MAX_AGE_SECONDS=31536000
# Enable only after confirming every required subdomain is HTTPS-managed.
BROWSER_HSTS_INCLUDE_SUBDOMAINS=false

# CSP modes: off = no CSP; monitor = report-only and non-blocking (pilot
# default); enforce = actively block resources outside the reviewed policy.
CSP_SECURITY_MODE=monitor
CSP_REPORTING_ENABLED=true
CSP_MAX_REPORT_BYTES=16384
# Current MVP templates use reviewed inline code. Turn these off only after
# migrating inline scripts/styles to nonces or static files and validating UI.
CSP_ALLOW_INLINE_SCRIPTS=true
CSP_ALLOW_INLINE_STYLES=true

# --- Structured security audit and safe public failures ---
# off = no persistent structured audit or routine request IDs; monitor =
# security decisions and failed requests; enforce = complete request/event
# lifecycle auditing. Unexpected public 500 responses always remain generic.
SECURITY_AUDIT_MODE=monitor
SECURITY_AUDIT_FILE=logs/security_audit.jsonl
SECURITY_AUDIT_MAX_BYTES=5242880
SECURITY_AUDIT_BACKUP_COUNT=7
SECURITY_AUDIT_RETENTION_DAYS=30

# Redis message queue and game-state connection. Required outside local development.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Safe Redis game-state storage ---
# Every mode uses strict versioned JSON; unsafe pickle loading cannot be enabled.
# off = safe codec with audit events disabled; monitor = safe codec plus rejection
# auditing (pilot default); enforce = also refuse non-local startup if Redis is down.
REDIS_GAME_STATE_SECURITY_MODE=monitor
# New game records expire after 24 hours and are capped at 256 KiB by default.
REDIS_GAME_STATE_TTL_SECONDS=86400
REDIS_GAME_STATE_MAX_BYTES=262144

# --- MojaPOS payment gateway ---
# true = local wallet debit only (sandbox/mock) — no real gateway calls.
# false = real MojaPOS integration (requires the credentials below).
MOJAPOS_MOCK_MODE=true

# MojaPOS sandbox / production credentials.
# NOTE: the service calls `{MOJAPOS_API_URL}/payments` to initiate payments
# (e.g. https://mojapos.com/api/payments/pay + /payments). Do NOT add a
# trailing /payments here or the URL will double up.
MOJAPOS_API_URL=https://sandbox.mojapos.com/v1
MOJAPOS_API_KEY=
MOJAPOS_MERCHANT_ID=
MOJAPOS_SECRET_KEY=
MOJAPOS_WEBHOOK_SECRET=
# Must be true for live payments; production startup fails closed otherwise.
MOJAPOS_VERIFY_WEBHOOK_SIGNATURE=false
# Exact callback reconciliation is mandatory in every mode. off disables only
# reconciliation audit events; monitor is the pilot default; enforce is the
# production setting after a verified end-to-end callback rehearsal.
MOJAPOS_WEBHOOK_RECONCILIATION_MODE=monitor
MOJAPOS_EXPECTED_ENVIRONMENT=SANDBOX
MOJAPOS_EXPECTED_CURRENCY=SZL
MOJAPOS_WEBHOOK_MAX_BYTES=32768
# Publicly reachable callback URL (must be HTTPS in production).
MOJAPOS_CALLBACK_URL=https://dealuxe.app/api/payment/callback

# When running through HTTPS:
# SESSION_COOKIE_SECURITY_MODE=enforce
# SESSION_ROTATION_MODE=enforce
# CSRF_SECURITY_MODE=enforce
# Secure=true must not be used on ordinary local HTTP because the browser will refuse to send the cookie.
