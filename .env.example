# uMshova Deluxe — environment variable reference
# Copy this file to `.env` (which is gitignored) and fill in your values.
# DO NOT commit secrets to the repository.

# --- Game / test bots ---
# When true, the reserved tournament_bot_1..3 accounts auto-play their turns
# so admins can test tournaments with 1 manual player + 3 bots.
TOURNAMENT_TEST_BOTS_ENABLED=true

# --- Flask environment ---
# "development" uses the threading Socket.IO async mode and permits an
# in-memory game-state fallback. Set an explicit non-local value in production
# to use gevent and require Redis plus the production security settings.
ENV=development

# High-entropy Flask session signing secret. Required outside local development.
# Generate a unique value per deployment; never commit the populated value.
FLASK_SECRET_KEY=

# Exact browser origins allowed to connect to Socket.IO, comma-separated.
# Wildcards are rejected. Use the public HTTPS origin in production.
SOCKETIO_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Redis message queue and game-state connection. Required outside local development.
REDIS_URL=redis://127.0.0.1:6379/0

# --- MojaPOS payment gateway ---
# true = local wallet debit only (sandbox/mock) — no real gateway calls.
# false = real MojaPOS integration (requires the credentials below).
MOJAPOS_MOCK_MODE=true

# MojaPOS sandbox / production credentials.
# NOTE: the service calls `{MOJAPOS_API_URL}/payments` to initiate payments
# (e.g. https://mojapos.com/api/payments/pay + /payments). Do NOT add a
# trailing /payments here or the URL will double up.
MOJAPOS_API_URL=https://sandbox.mojapos.com/v1
MOJAPOS_API_KEY=
MOJAPOS_MERCHANT_ID=
MOJAPOS_SECRET_KEY=
MOJAPOS_WEBHOOK_SECRET=
# Must be true for live payments; production startup fails closed otherwise.
MOJAPOS_VERIFY_WEBHOOK_SIGNATURE=false
# Publicly reachable callback URL (must be HTTPS in production).
MOJAPOS_CALLBACK_URL=https://dealuxe.app/api/payment/callback
